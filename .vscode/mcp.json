{
  "servers": {
    "mangu-publishers": {
      "type": "http",
      "url": "http://localhost:3000/api/mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${input:mcpApiKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "mcpApiKey",
      "type": "promptString",
      "description": "MCP_API_KEY for Mangu Publishers MCP server",
      "password": true
    }
  ]
}
